== claude: bridge prefix its lineage adapter writes
-- skill search block (posix)
JEVLIN_TRACE_BRIDGE=<BRIDGE> 'C:\Users\u\.jevlin\bin\jevlin.exe' search -config 'C:\Users\u\.jevlin\jevlin.toml' --stdin <<'JSON'
{"version":1,"query":"exact query text"}
JSON
-- stdin command (posix)
JEVLIN_TRACE_BRIDGE=<BRIDGE> 'C:\Users\u\.jevlin\bin\jevlin.exe' search -config 'C:\Users\u\.jevlin\jevlin.toml' --stdin
-- skill search block (powershell)
$env:JEVLIN_TRACE_BRIDGE = '<BRIDGE>'; try { $OutputEncoding = [System.Text.UTF8Encoding]::new($false)
@'
{"version":1,"query":"exact query text"}
'@ | & 'C:\Users\u\.jevlin\bin\jevlin.exe' search -config 'C:\Users\u\.jevlin\jevlin.toml' --stdin
} finally { Remove-Item Env:JEVLIN_TRACE_BRIDGE -ErrorAction SilentlyContinue }
-- stdin command (powershell)
$env:JEVLIN_TRACE_BRIDGE = '<BRIDGE>'; try { & 'C:\Users\u\.jevlin\bin\jevlin.exe' search -config 'C:\Users\u\.jevlin\jevlin.toml' --stdin
} finally { Remove-Item Env:JEVLIN_TRACE_BRIDGE -ErrorAction SilentlyContinue }

