== claude: settings.json permissions.allow rules
-- rule
Bash('/home/u/.jevlin/bin/jevlin' search -config '/home/u/.jevlin/jevlin.toml':*)
"Bash('/home/u/.jevlin/bin/jevlin' search -config '/home/u/.jevlin/jevlin.toml':*)"
-- rule
Bash("/home/u/.jevlin/bin/jevlin" search -config "/home/u/.jevlin/jevlin.toml":*)
"Bash(\"/home/u/.jevlin/bin/jevlin\" search -config \"/home/u/.jevlin/jevlin.toml\":*)"
-- rule
Bash(/home/u/.jevlin/bin/jevlin search -config "/home/u/.jevlin/jevlin.toml":*)
"Bash(/home/u/.jevlin/bin/jevlin search -config \"/home/u/.jevlin/jevlin.toml\":*)"
-- rule
Bash('/home/u/.jevlin/bin/jevlin' fetch -config '/home/u/.jevlin/jevlin.toml' --stdin:*)
"Bash('/home/u/.jevlin/bin/jevlin' fetch -config '/home/u/.jevlin/jevlin.toml' --stdin:*)"
-- rule
Bash("/home/u/.jevlin/bin/jevlin" fetch -config "/home/u/.jevlin/jevlin.toml" --stdin:*)
"Bash(\"/home/u/.jevlin/bin/jevlin\" fetch -config \"/home/u/.jevlin/jevlin.toml\" --stdin:*)"
-- rule
Bash(/home/u/.jevlin/bin/jevlin fetch -config "/home/u/.jevlin/jevlin.toml" --stdin:*)
"Bash(/home/u/.jevlin/bin/jevlin fetch -config \"/home/u/.jevlin/jevlin.toml\" --stdin:*)"
-- rule
Edit(//home/u/.jevlin/requests/**)
"Edit(//home/u/.jevlin/requests/**)"
-- rule
Read(//home/u/.jevlin/requests/**)
"Read(//home/u/.jevlin/requests/**)"

