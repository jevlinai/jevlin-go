{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "'<BIN>' hook -config '<CFG>' codex PostCompact",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "'<BIN>' hook -config '<CFG>' codex PreCompact",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'<BIN>' hook -config '<CFG>' codex PreToolUse",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "'<BIN>' hook -config '<CFG>' codex SessionStart",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'<BIN>' hook -config '<CFG>' codex Stop",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
