# Private documents. Git history is permanent: a file committed once and deleted later can
# still be read with `git log -p`, so these must never be committed at all.
docs/private/
*.private.md
# email_sweep_test.go's optional plain-text denylist; it lives on the maintainer's machine.
/.email-sweep-denylist

# Build output.
/jevlin
/releasecheck
/bin/
/dist/
/build/
*.exe
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work*

# Local state and secrets: keys, tokens, spooled records, logs and profiles can all hold them.
.jevlin/
jevlin.toml
*.key
*.pem
.env
.env.*
*.log
*.db
*.sqlite*
*.jwt
*.jwk
*.jwks
*.prof
*.pprof
*.sock
/spool/
# Generated fuzz corpora can hold whatever was fed to the parser; reviewed seeds live in testdata/.
**/testdata/fuzz/

# Editor and OS.
.DS_Store
.idea/
.vscode/
*.swp
